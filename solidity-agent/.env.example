PORT=5001
# Shared secret the backend sends in x-agent-secret; protects /deploy (it spends the designer wallet's HBAR)
AGENT_SHARED_SECRET=

# The agent's own wallet: the only address allowed to deploy task contracts. Testnet only. Never commit .env
DESIGNER_PRIVATE_KEY=
TASK_FACTORY_ADDRESS=
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296

# Requirement analysis. If the key is unset or the call fails, a simple heuristic is used and flagged.
LLM_PROVIDER=near
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.3-flash
# Only used when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
