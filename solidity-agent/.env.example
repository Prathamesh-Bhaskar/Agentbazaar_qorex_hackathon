PORT=5001
# If you set the keys in ../backend/.env, set DESIGNER_PORT there instead (and match the backend's SOLIDITY_AGENT_URL)
# Shared secret the backend sends in x-agent-secret (the backend's SOLIDITY_AGENT_SECRET); protects /deploy, which spends the designer's QOR
AGENT_SHARED_SECRET=

# The designer's own account: the only address allowed to deploy task contracts. Testnet only. Never commit .env.
# It needs a registered PQC key (recovery code below) and an EVM window, which the service opens by itself.
# If unset here, the keys are read from ../backend/.env.
QORE_DESIGNER_PRIVATE_KEY=
QORE_DESIGNER_PQC_RECOVERY_CODE=
TASK_FACTORY_ADDRESS=

# QoreChain testnet (qorechain-diana)
QORE_EVM_RPC_URL=https://evm-testnet.qore.host
QORE_CHAIN_ID=9800
QORE_COSMOS_CHAIN_ID=qorechain-diana
QORE_REST_URL=https://api-testnet.qore.host
QORE_RPC_URL=https://rpc-testnet.qore.host
# EVM authorisation window sizing (value in uqor, 1 QOR = 1000000)
QORE_WINDOW_BLOCKS=17280
QORE_WINDOW_MAX_TXS=200
QORE_WINDOW_MAX_VALUE_UQOR=5000000
QORE_WINDOW_MIN_BLOCKS=120

# Requirement analysis. If the key is unset or the call fails, a simple heuristic is used and flagged.
# AI model for requirement analysis: NVIDIA-hosted (OpenAI-compatible API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
