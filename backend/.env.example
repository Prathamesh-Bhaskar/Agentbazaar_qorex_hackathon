PORT=4000
CORS_ORIGIN=http://localhost:3000
# How agents reach this API (they call /agreements/:id/submit and /a2a/*)
API_PUBLIC_URL=http://localhost:4000
# Sent to agents in x-backend-secret; must equal the BACKEND_SECRET configured on the agent (optional)
BACKEND_SECRET=

# Neon Postgres connection string (include ?sslmode=require)
DATABASE_URL=

# QoreChain testnet (qorechain-diana)
QORE_EVM_RPC_URL=https://evm-testnet.qore.host
QORE_CHAIN_ID=9800
QORE_COSMOS_CHAIN_ID=qorechain-diana
QORE_REST_URL=https://api-testnet.qore.host
QORE_RPC_URL=https://rpc-testnet.qore.host
QORE_EXPLORER_URL=https://explore.qore.network
# Indexer: eth_getLogs is limited to <10,000 blocks per call; confirmations is a safety margin in blocks
QORE_LOGS_CHUNK_BLOCKS=5000
QORE_CONFIRMATIONS=1

# AI inference: NVIDIA-hosted models (OpenAI-compatible API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# 0G Storage
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
BACKEND_0G_PRIVATE_KEY=

# Testnet-only keys. Never commit .env.
# EVM authorisation window sizing (blocks 1..17280 is about 5 h on testnet; value in uqor, 1 QOR = 1000000)
QORE_WINDOW_BLOCKS=17280
QORE_WINDOW_MAX_TXS=200
QORE_WINDOW_MAX_VALUE_UQOR=5000000
QORE_WINDOW_MIN_BLOCKS=120
# Operator = relayer + factory owner (sends every backend transaction; needs a registered PQC key and an open EVM window).
QORE_OPERATOR_PRIVATE_KEY=
QORE_OPERATOR_PQC_RECOVERY_CODE=
# Verifier only signs EIP-712 verdicts (sends no transactions).
QORE_VERIFIER_PRIVATE_KEY=

# GitHub OAuth app (github.com/settings/developers). Callback URL must equal GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/github/callback
FRONTEND_URL=http://localhost:3000
# Optional personal token to raise the unauthenticated 60/hour GitHub limit
GITHUB_TOKEN=

# Benchmark
BENCHMARK_PASS_SCORE=80
BENCHMARK_CUSTOM_WEIGHT=0.4



# Solidity agent (separate service) that designs and deploys each task contract
SOLIDITY_AGENT_URL=http://localhost:5001
SOLIDITY_AGENT_SECRET=

# The remaining accounts. `npm run setup:accounts` creates any that are missing and registers the funded ones.
# Designer (deploys each job contract; read by solidity-agent)
QORE_DESIGNER_PRIVATE_KEY=
QORE_DESIGNER_PQC_RECOVERY_CODE=
# DESIGNER_PORT=5001   (change it, and SOLIDITY_AGENT_URL above, if the port is taken)
# The deployed TaskFactory (see contracts/deployments.json)
TASK_FACTORY_ADDRESS=0xf7b32D5AD9A691863E50af2E2A3F6decFF695BB4
# Live agents (read by live-agents)
QORE_AGENT_SOLIDITY_DEV_PRIVATE_KEY=
QORE_AGENT_SOLIDITY_DEV_PQC_RECOVERY_CODE=
QORE_AGENT_SECURITY_AUDITOR_PRIVATE_KEY=
QORE_AGENT_SECURITY_AUDITOR_PQC_RECOVERY_CODE=
QORE_AGENT_TEST_WRITER_PRIVATE_KEY=
QORE_AGENT_TEST_WRITER_PQC_RECOVERY_CODE=
QORE_AGENT_DOCS_WRITER_PRIVATE_KEY=
QORE_AGENT_DOCS_WRITER_PQC_RECOVERY_CODE=
QORE_AGENT_DAPP_DEV_PRIVATE_KEY=
QORE_AGENT_DAPP_DEV_PQC_RECOVERY_CODE=

