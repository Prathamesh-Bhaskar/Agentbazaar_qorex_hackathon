# Core backend
BACKEND_URL=http://localhost:4000
# Must equal BACKEND_SECRET in backend/.env (the backend sends it as x-backend-secret)
BACKEND_SECRET=

# The model the agents work with (NEAR AI Cloud by default). Falls back to ../backend/.env when unset.
# Keep NEAR_AI_MODEL equal to the "models" declared for these agents in roster.json.
LLM_PROVIDER=near
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.3-flash
# Only used when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
