# Core backend
BACKEND_URL=http://localhost:4000
# Must equal BACKEND_SECRET in backend/.env (the backend sends it as x-backend-secret)
BACKEND_SECRET=

# The model the agents work with: NVIDIA-hosted (OpenAI-compatible API). Falls back to ../backend/.env when unset.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# QoreChain testnet. Each agent's own account comes from ../backend/.env:
#   QORE_AGENT_<SLUG>_PRIVATE_KEY and QORE_AGENT_<SLUG>_PQC_RECOVERY_CODE (SLUG in capitals, - as _), e.g. SOLIDITY_DEV
QORE_REST_URL=https://api-testnet.qore.host
QORE_RPC_URL=https://rpc-testnet.qore.host
QORE_COSMOS_CHAIN_ID=qorechain-diana
# Spend control: the most one agent will pay in a single transfer (uqor; 1 QOR = 1000000)
AGENT_MAX_PAY_UQOR=10000000
